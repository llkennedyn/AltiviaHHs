# Copiar los valores a Settings > Secrets de Streamlit Community Cloud.
# Nunca subir el archivo real secrets.toml a GitHub.
DATA_BACKEND = "sharepoint"
SP_TENANT_ID = "TENANT-ID"
SP_CLIENT_ID = "APPLICATION-ID"
SP_SITE_ID = "HOST.sharepoint.com,SITE-COLLECTION-ID,WEB-ID"
SP_LIST_PREFIX = "HH_"
SP_CERT_THUMBPRINT = "CERTIFICATE-THUMBPRINT"
SP_PRIVATE_KEY = """REPLACE-IN-PRIVATE-CONFIGURATION-ONLY"""
# En una PC se puede usar SP_PRIVATE_KEY_FILE en lugar de SP_PRIVATE_KEY.
# Solo para inicializar una instalación vacía; retirar después:
# ALTIVIA_SETUP_TOKEN = "PRIVATE-RANDOM-INSTALLATION-TOKEN"
# Alternativa anterior: DATA_BACKEND = "postgresql"
# DATABASE_URL = "postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require"
